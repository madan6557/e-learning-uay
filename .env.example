# ====================================================================
# KONFIGURASI E-LEARNING UNIVERSITAS ACHMAD YANI (UAY)
# Berdasarkan Dokumen Resmi: LEMBAR_DATA_DAN_ENV_INTEGRASI_UAY.pdf (v1.1)
# ====================================================================

# --------------------------------------------------------------------
# A. LINGKUNGAN PRODUKSI (VPS Linux / Hostinger Server)
# Lokasi file pada VPS: /etc/uay-elearning-api
# --------------------------------------------------------------------
NODE_ENV=production
PORT=3000
API_HOST=0.0.0.0
TRUST_PROXY=1

# Domain & Asal URL Aplikasi (Resmi UAY)
APP_ORIGIN=https://e-learning.uay.ac.id
API_ORIGIN=https://e-learning.uay.ac.id

# Database PostgreSQL & Redis Cache
DATABASE_URL=postgresql://uay_admin:PasswordKuatVps2026@127.0.0.1:5432/elearning?schema=public
REDIS_URL=redis://127.0.0.1:6379

# Mode Autentikasi Produksi (Wajib OIDC)
AUTH_MODE=oidc
DEMO_MODE=false

# Integrasi UAY SSO / Keycloak Identity Engine
SSO_ISSUER=https://sso.uay.ac.id/realms/uay
SSO_CLIENT_ID=elearning-uay
SSO_CLIENT_SECRET=IsiDenganClientSecretJikaConfidential
SSO_AUDIENCE=elearning-uay
SSO_REDIRECT_URI=https://e-learning.uay.ac.id/api/v1/auth/callback
SSO_WEBHOOK_SECRET=uay_sec_live_webhook_revocation_key_2026

# Integrasi Resmi UAY File Service (Wajib Aktif di Produksi)
FILE_STORAGE_DRIVER=uay
UAY_FILE_SERVICE_URL=https://file-service.uay.ac.id/api/v1
UAY_FILE_SERVICE_CLIENT_ID=elearning-uay
UAY_FILE_SERVICE_API_KEY=uay_sec_live_m2m_file_service_key
UAY_FILE_SERVICE_REPOSITORY_ID=a1b2c3d4-e5f6-7890-abcd-1234567890ab
FILE_ALLOWED_ORIGINS=https://file-service.uay.ac.id

# Embed Media yang Diizinkan
EMBED_ALLOWED_ORIGINS=https://www.youtube.com,https://www.youtube-nocookie.com,https://drive.google.com

# Integrasi Telemetri Snapshot Rektor (Opsional)
# RECTOR_BRIDGE_TOKEN=


# --------------------------------------------------------------------
# B. LINGKUNGAN STAGING / CLOUD DEV (Railway Backend & Vercel Frontend)
# --------------------------------------------------------------------
# Vercel Environment Variables:
# RAILWAY_API_ORIGIN=https://e-learning-uay-production.up.railway.app
#
# Railway Service Environment Variables:
# NODE_ENV=production
# PORT=3000
# TRUST_PROXY=1
# APP_ORIGIN=https://e-learning-uay.vercel.app
# API_ORIGIN=https://e-learning-uay-production.up.railway.app
