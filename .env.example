# ====================================================================
# Konfigurasi Lingkungan E-Learning Universitas Achmad Yani (UAY)
# Deployment VPS Hostinger / Linux Server dengan PM2
# ====================================================================

# Port & Server Host
NODE_ENV=production
PORT=3000
API_HOST=0.0.0.0
TRUST_PROXY=1

# Domain / URL Publik Aplikasi
# Sesuaikan dengan domain atau IP publik VPS Hostinger Anda
# Contoh: http://194.233.xx.xx:3000 atau https://e-learning.uay.ac.id
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3000

# Database PostgreSQL di VPS Hostinger
# Format: postgresql://<user>:<password>@127.0.0.1:5432/<dbname>?schema=public
DATABASE_URL=postgresql://uay:password_vps@127.0.0.1:5432/elearning?schema=public

# Redis (Opsional untuk caching & session di VPS, biarkan kosong jika tidak memakai Redis)
REDIS_URL=

# Mode Autentikasi & Akun
# DEMO_MODE=true mengaktifkan mode uji coba (akun Dosen, Mahasiswa, Admin Prodi, Super Admin langsung tersedia tanpa SSO)
DEMO_MODE=true
AUTH_MODE=development

# Penyimpanan Berkas:
# PERHATIAN: Mode produksi (NODE_ENV=production tanpa DEMO_MODE) WAJIB menggunakan File Service institusi.
# Penyimpanan berkas lokal (FILE_STORAGE_DRIVER=local) hanya diperbolehkan untuk mode pengembangan (development / demo).
FILE_STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# Konfigurasi SSO Institusi (Diisi jika nanti dokumentasi & integrasi SSO UAY sudah siap)
# SSO_ISSUER=https://sso.uay.ac.id/realms/uay
# SSO_CLIENT_ID=elearning-uay
# SSO_CLIENT_SECRET=your_client_secret
# SSO_AUDIENCE=elearning-uay
# SSO_REDIRECT_URI=https://e-learning.uay.ac.id/api/v1/auth/callback

# Konfigurasi File Service Institusi (UAY File Service)
# Berdasarkan DOKUMENTASI_API_ENDPOINT.pdf
# Mode produksi WAJIB mengisi File Service (UAY_FILE_SERVICE_* atau FILE_SERVICE_*).
# UAY_FILE_SERVICE_URL=http://file-service.uay.ac.id/api/v1
# UAY_FILE_SERVICE_API_KEY=uay_sec_live_example
# UAY_FILE_SERVICE_REPOSITORY_ID=00000000-0000-0000-0000-000000000001
# UAY_FILE_SERVICE_CLIENT_ID=elearning-uay

# Fallback variabel lingkungan sebelumnya (tetap didukung penuh di produksi)
# FILE_SERVICE_URL=
# FILE_SERVICE_KEY=
# FILE_ALLOWED_ORIGINS=

# Konten Video / Embed yang Diizinkan
EMBED_ALLOWED_ORIGINS=https://www.youtube.com,https://www.youtube-nocookie.com,https://drive.google.com

# Opsional: token khusus pembacaan snapshot Dashboard Rektor.
# Jika kosong, endpoint hanya tersedia melalui sesi Super Admin.
# RECTOR_BRIDGE_TOKEN=
