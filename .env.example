# AUTH_MODE=oidc
# DEMO_MODE=false
# SSO_ISSUER=https://sso.uay.ac.id/realms/uay
# SSO_CLIENT_ID=elearning-uay
# SSO_AUDIENCE=elearning-uay
# SSO_REDIRECT_URI=https://e-learning-uay.vercel.app/api/v1/auth/callback
# SSO_WEBHOOK_SECRET=uay_sec_staging_webhook_revocation_key
# FILE_STORAGE_DRIVER=uay
# UAY_FILE_SERVICE_URL=https://file-service.uay.ac.id/api/v1
# UAY_FILE_SERVICE_CLIENT_ID=elearning-uay
# UAY_FILE_SERVICE_API_KEY=uay_sec_staging_file_service_key
# UAY_FILE_SERVICE_REPOSITORY_ID=a1b2c3d4-e5f6-7890-abcd-1234567890ab
# FILE_ALLOWED_ORIGINS=https://e-learning-uay.vercel.app,https://e-learning-uay-production.up.railway.app


