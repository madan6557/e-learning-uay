# Copy to project-root .env, chmod 600, and fill actual values.
NODE_ENV=production
DEMO_MODE=false
AUTH_MODE=oidc
PORT=3000
API_HOST=127.0.0.1
TRUST_PROXY=1
APP_ORIGIN=https://elearning.example.ac.id
API_ORIGIN=https://elearning.example.ac.id
DATABASE_URL=postgresql://elearning:CHANGE_ME@127.0.0.1:5432/elearning_prod?schema=public
# Optional during grace; configure Redis for shared sessions across workers.
REDIS_URL=
SSO_ISSUER=https://sso.example.ac.id
SSO_CLIENT_ID=elearning-uay
SSO_CLIENT_SECRET=CHANGE_ME
SSO_AUDIENCE=elearning-uay
SSO_REDIRECT_URI=https://elearning.example.ac.id/api/v1/auth/callback
# Optional during grace; revocations return 503 until the shared secret is set.
SSO_WEBHOOK_SECRET=
SSO_ACCOUNT_URL=https://sso.example.ac.id/account
FILE_SERVICE_URL=https://files.example.ac.id
# Use uay for official API, s3 for S3-compatible cloud storage (Railway Tigris / AWS), legacy for legacy API.
FILE_SERVICE_TYPE=uay
FILE_SERVICE_KEY=CHANGE_ME
FILE_ALLOWED_ORIGINS=https://files.example.ac.id

# S3-compatible Backup Storage (Railway Tigris / AWS S3):
# Aktif otomatis jika FILE_SERVICE_TYPE=s3 atau jika variabel S3 diisi
# FILE_SERVICE_TYPE=s3
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_REGION=auto
# S3_BUCKET=arranged-lounge-j7sbw8iq1
# S3_ACCESS_KEY_ID=tid_zImBpKfObONAYpHBoICnphxCNDKgcIbhCRWjkcPiaHWpnvTAfT
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_FORCE_PATH_STYLE=true

# Izin seeding pada mode demo/staging VPS:
# ALLOW_SEED=true

EMBED_ALLOWED_ORIGINS=https://www.youtube.com,https://www.youtube-nocookie.com,https://drive.google.com
