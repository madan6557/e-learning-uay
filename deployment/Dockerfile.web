FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --ignore-scripts
COPY apps/web apps/web
COPY packages/shared/src packages/shared/src
RUN npx tsc -p apps/web/tsconfig.json && npx vite build --config apps/web/vite.config.ts
FROM nginx:1.28-alpine
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY deployment/nginx/web.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s CMD wget -q -O /dev/null http://127.0.0.1/
